<Window
    x:Class="ReTweak.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ReTweak.App"
    Title="ReTweak">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBar" Height="40" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/ReTweak.ico" Width="18" Height="18" />
                <TextBlock Text="ReTweak" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.GpuName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="20,4,20,20" Spacing="16">

                <!-- Header -->
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.GpuName}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="14" Padding="14,6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Button Click="Settings_Click" ToolTipService.ToolTip="Settings" Padding="8">
                            <SymbolIcon Symbol="Setting" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Active alerts -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AlertViewModel">
                            <InfoBar IsOpen="True" IsClosable="False" Margin="0,0,0,6"
                                     Severity="{x:Bind Severity}" Title="{x:Bind Title}" Message="{x:Bind Detail}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- GPU tiles -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GPU core temperature" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Memory temperature" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.MemoryTemperature, Mode=OneWay}" Style="{StaticResource TileValue}" />
                            <TextBlock Text="Not reported by this card" Visibility="{x:Bind local:MainWindow.Not(ViewModel.HasMemoryTemp)}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MemoryTempSource, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasMemoryTemp}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GPU load" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Load, Mode=OneWay}" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fans" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Fans, Mode=OneWay}" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Core clock" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.CoreClock, Mode=OneWay}" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Memory clock" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.MemoryClock, Mode=OneWay}" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" ToolTipService.ToolTip="{x:Bind ViewModel.HotspotHelp}">
                        <StackPanel>
                            <TextBlock Text="GPU hotspot" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Hotspot, Mode=OneWay}" Style="{StaticResource TileValue}" />
                            <TextBlock Text="{x:Bind ViewModel.HotspotNote}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton Content="Get PawnIO" Padding="0" Margin="0,2,0,0" NavigateUri="https://pawnio.eu/"
                                             Visibility="{x:Bind ViewModel.OfferPawnIo}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Board power" Style="{StaticResource TileLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.Power, Mode=OneWay}" Style="{StaticResource TileValue}" />
                                <TextBlock Text="{x:Bind ViewModel.PowerLimit, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ProgressBar Value="{x:Bind ViewModel.PowerPercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VRAM" Style="{StaticResource TileLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.Vram, Mode=OneWay}" Style="{StaticResource TileValue}" />
                            <ProgressBar Value="{x:Bind ViewModel.VramPercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fan control -->
                <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.HasFanControl}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="10" MinWidth="320">
                            <TextBlock Text="Fan control" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.FanModeIndex, Mode=TwoWay}" MaxColumns="3">
                                <x:String>Auto</x:String>
                                <x:String>Fixed</x:String>
                                <x:String>Curve</x:String>
                            </RadioButtons>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.FanStatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.FanStatus, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="300" />
                            </StackPanel>
                            <Button Content="Restart as administrator" Click="RestartElevated_Click"
                                    Visibility="{x:Bind ViewModel.FanNeedsAdmin, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="320"
                                       Text="Edit the curve, fixed speed and failsafe in Settings. Auto, closing ReTweak or a lost temperature reading hands the fans back to the driver." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Style="{StaticResource TileLabel}">
                                <Run Text="Fan curve · core °C → fan % (dot: now)" />
                                <Run Text="{x:Bind ViewModel.FanSpeedRange}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                            <Canvas x:Name="FanChart" Height="140" SizeChanged="Chart_SizeChanged"
                                    Background="{ThemeResource ControlFillColorTransparentBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ASUS board temperature sensors -->
                <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.HasBoardTemps}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Board temperatures · ASUS sensors" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.BoardTemps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="28" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:BoardTempViewModel">
                                    <StackPanel MinWidth="90">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource TileLabel}" />
                                        <TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 12V-2x6 connector -->
                <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.HasConnector}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="10">
                            <TextBlock Text="12V-2x6 connector · per pin" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Pins}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="14" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:PinViewModel">
                                        <StackPanel Width="64" Spacing="4">
                                            <Grid Height="160" Width="28" HorizontalAlignment="Center" CornerRadius="4"
                                                  Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                                                <Rectangle VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"
                                                           Height="{x:Bind BarHeight, Mode=OneWay}" Fill="{x:Bind Brush, Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Amps, Mode=OneWay}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Volts, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <!-- 2 x 2 so the stats stay readable next to the pin bars at smaller window widths -->
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Connector power" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.ConnectorWatts, Mode=OneWay}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Total current" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.ConnectorAmps, Mode=OneWay}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Voltage spread" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.Spread, Mode=OneWay}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="Imbalance" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.Imbalance, Mode=OneWay}" Style="{StaticResource TileValue}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Connector power · last 60 s" Style="{StaticResource TileLabel}" />
                            <Canvas x:Name="PowerChart" Height="80" SizeChanged="Chart_SizeChanged"
                                    Background="{ThemeResource ControlFillColorTransparentBrush}" />

                            <TextBlock Text="Lowest pin voltage · last 60 s (dashed: warn / critical)" Style="{StaticResource TileLabel}" />
                            <Canvas x:Name="VoltChart" Height="80" SizeChanged="Chart_SizeChanged"
                                    Background="{ThemeResource ControlFillColorTransparentBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                         Visibility="{x:Bind local:MainWindow.Not(ViewModel.HasConnector)}"
                         Title="No per-pin connector sensor"
                         Message="This card doesn't have the ASUS Power Detector chip, so only total board power is available." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
